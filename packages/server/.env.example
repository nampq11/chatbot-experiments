# Server
HOST=0.0.0.0
PORT=8080

# Database (MySQL)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/chatbot_experiments

# CORS (comma-separated exact origins or /regex/ entries)
CORS_ORIGIN=/^http:\/\/localhost:\d+$/,/^https?:\/\/([a-z0-9-]+\.)*chatbot-experiments.local$/

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
