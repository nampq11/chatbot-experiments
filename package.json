{
  "name": "chatbot-experiments",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev -- --port 3002",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm exec biome check --write --error-on-warnings . && pnpm check:boundaries && pnpm typecheck && pnpm test",
    "check:full": "pnpm check && pnpm test:e2e",
    "format": "pnpm exec biome check --write . && prettier --write \"**/*.{md,yaml,yml}\"",
    "typecheck": "turbo run check-types",
    "check-types": "turbo run check-types",
    "ui:add": "pnpm dlx shadcn@latest add --cwd packages/ui"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@types/react": "19.2.2",
      "@types/react-dom": "19.2.2",
      "esbuild": "0.28.0"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@playwright/test": "^1.50.0",
    "@types/node": "^22.15.3",
    "autoprefixer": "^10.5.0",
    "esbuild": "0.28.0",
    "postcss": "^8.5.15",
    "prettier": "^3.7.4",
    "tailwindcss": "^3",
    "turbo": "^2.9.14",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
