# Server
HOST=0.0.0.0
PORT=8080

# Database (MySQL) - shared by Makefile, docker compose, and local scripts
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=dentaltrip

# Database (MySQL) - Connection string (for server)
DATABASE_URL=mysql://root:password@127.0.0.1:3306/dentaltrip

# CORS (comma-separated exact origins or /regex/ entries)
CORS_ORIGIN=/^http:\/\/localhost:\d+$/,/^https?:\/\/([a-z0-9-]+\.)*dentaltrip\.io$/

# Azure OpenAI
AZURE_OPENAI_ENDPOINT=https://example.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key
AZURE_OPENAI_API_VERSION=2024-10-21
